@article{martinolli_scholarly_2022,
	title = {A {Scholarly} {Character} {Sheet} to {Frame} {Learning} {Activities} and {Improve} {Engagement}},
	copyright = {Licence Creative Commons Attribution 4.0 International (CC-BY)},
	issn = {2210-4909},
	url = {https://journals.uu.se/IJRP/article/view/291},
	doi = {10.33063/ijrp.vi12.291},
	abstract = {Character sheets are an essential element of game design for tabletop role-playing games. They can be adapted to frame a series of learning activities and to improve participants' engagement. In this study, they are used at the beginning of a five-session graduate seminar on library instruction to assess the participants' knowledge and present the curriculum. They are also used as wrap-up at the end of the final session to measure the participants' progress. Besides providing a better assessment of the group by the instructor, the character sheet activity improves comprehension of the content and offers an engaging opportunity to start the seminar and create a personal connection with the students. Through objectivation, a theoretical framework, I argue that character sheets can support metacognitive abilities like self-authorship, self-determination, and a growth mindset. By framing and matching the content with the participants' personal journey, character sheets provide gamified syllabi to improve motivation, engagement, and learning outcomes in a series of workshop activities.},
	language = {en},
	number = {12},
	urldate = {2022-10-06},
	journal = {International Journal of Role-Playing},
	author = {Martinolli, Pascal},
	year = {2022},
	note = {QID: Q114437555},
	keywords = {\_character sheet, \_curriculum, \_information literacy, \_LEARNING, \_library, \_metagame, \_motivation, \_peer reviewed, \_roleplayification, \_self-advocacy, \_self-determination, \_self-efficacy, \_self-reflection, \_teaching, \_TTRPG, =cleaned, Active learning, character sheet, engagement, framed learning, game-based learning, growth mindset, self-assessment, self-authorship, self-determination, tabletop role-playing game},
	pages = {40--61},
    selected={true},
    dimensions={true},
    altmetric={159879687},
    google_scholar_id={MXK_kJrjxJIC},
    abbr={IJRP},
	file = {Martinolli - 2022 - A Scholarly Character Sheet to Frame Learning Acti.pdf:C\:\\Users\\martinop\\Documents\\Zotero-SideB\\storage\\CIGUZ3VP\\Martinolli - 2022 - A Scholarly Character Sheet to Frame Learning Acti.pdf:application/pdf},
