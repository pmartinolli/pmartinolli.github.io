@inproceedings{martinolli_critique_2019,
	address = {Montréal},
	title = {La critique des autorités et le "foutaisomètre"},
	url = {http://hdl.handle.net/1866/22188},
	abstract = {Cette présentation a été faite pour les responsables de formation du réseau des bibliothèques du collégial du Québec (REBICQ). Elle présente des bonnes pratiques de formation à l'évaluation des sources.  
La première partie explique le cadre conceptuel des ateliers de formation, où le bibliothécaire se concentre principalement sur les critères d'autorité et où il laisse la partie sur l'évaluation du contenu au professeur ou au programme d'étude. 
La seconde partie détaille l'utilisation du « foutaisomètre », une grille d'analyse ludifiée, permettant de sortir de l'évaluation binaire classique Oui/Non et de pondérer positivement ou négativement les éléments de l'information. 
La troisième partie est une discussion sur la ludification d'activités de formation sur les compétences informationnelles, l'adaptation du foutaisomètre à différents contextes, la relation d'hospitalité et le dialogue avec le professeur en formation.},
	language = {fr},
	urldate = {2022-11-04},
	booktitle = {Rencontre {REBICQ} 2019, {Collège} {Vanier}},
	author = {Martinolli, Pascal},
	month = jul,
	year = {2019},
	note = {Accepted: 2019-06-25T18:06:17Z},
