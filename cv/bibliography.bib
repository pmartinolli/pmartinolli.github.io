@misc{martinolli_bonici_2020,
	title = {{BONICI} : {Repérer} et gérer l’information},
	shorttitle = {{BONICI}},
	url = {https://catalogue.edulib.org/fr/cours/bib-bonici/},
	abstract = {Pourquoi BONICI? Pour BONIfier vos Compétences Informationnelles! Ces compétences vous serviront à bien repérer et gérer l'information. Ce cours vise à former les étudiants du premier cycle aux bases de la recherche et de l'exploitation documentaire. Il s'adresse principalement aux étudiants en lettres, sciences humaines et sociales et certaines questions portent spécifiquement sur les ressources et outils UdeM. 

Les objectifs généraux sont:
maîtriser les outils et stratégies de recherche;
évaluer ses sources;
citer sans plagier;
respecter les droits d'auteur;
gérer ses références et bibliographies;
faire de la veille informationnelle.
Il vous permettra de faciliter vos études en vous faisant gagner du temps de qualité et en vous aidant à prendre les bonnes décisions dans la conduite de vos recherches et dans la gestion de votre information. Vous pourrez le suivre à votre rythme. J'espère que vous prendrez autant de plaisir à accomplir ce cours que nous en avons eu à le concevoir pour vous. C'est un travail exigeant mais les compétences que vous allez développer vont contribuer au succès de vos études et de votre vie professionnelle.},
	language = {fr},
	urldate = {2022-11-04},
	publisher = {MOOC EDUlib},
	author = {Martinolli, Pascal and Bourque, Marilou and Dalpé, Émilie and Gendreau, Paul},
	year = {2020},
}

